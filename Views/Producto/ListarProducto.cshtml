@model IEnumerable<Producto>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay productos en la base de datos.</div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Precio</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Producto item in Model)
            {
                <tr>
                    <td>@item.id_producto</td>
                    <td>@item.nombre</td>
                    <td>@item.descripcion</td>
                    <td>@item.precio</td>
                </tr>
            }
        </tbody>
    </table>
}
